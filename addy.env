TZ=America/New_York
PUID=1000
PGID=1000

MEMORY_LIMIT=256M
UPLOAD_MAX_SIZE=16M
OPCACHE_MEM_SIZE=128
REAL_IP_FROM=0.0.0.0/32
REAL_IP_HEADER=X-Forwarded-For
LOG_IP_VAR=http_x_forwarded_for

APP_KEY= <Run Command: echo "base64:$(openssl rand -base64 32)">
APP_DEBUG=false
APP_URL=https://addy.rotide.com

RSPAMD_ENABLE=true

ANONADDY_RETURN_PATH=bounces@<domain>
ANONADDY_ADMIN_USERNAME=<username>
ANONADDY_ENABLE_REGISTRATION=false
ANONADDY_DOMAIN=<domain>
ANONADDY_ALL_DOMAINS=<domain>
ANONADDY_HOSTNAME=addy.<domain>
ANONADDY_DNS_RESOLVER=127.0.0.1
ANONADDY_SECRET= <Run Command: tr -dc A-Za-z0-9 </dev/urandom | head -c 32; echo>
ANONADDY_LIMIT=200
ANONADDY_BANDWIDTH_LIMIT=104857600
ANONADDY_NEW_ALIAS_LIMIT=10
ANONADDY_ADDITIONAL_USERNAME_LIMIT=3

MAIL_FROM_NAME=addy
MAIL_FROM_ADDRESS=addy@<domain>

POSTFIX_DEBUG=false
POSTFIX_SMTPD_TLS=false
POSTFIX_SMTP_TLS=false
